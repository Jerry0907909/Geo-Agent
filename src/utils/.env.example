# API 密钥配置（复制为 .env 后填入真实值）
API_KEY=your_api_key_here

# LLM 模型配置
LLM_API_ENDPOINT=https://api.siliconflow.cn/v1/chat/completions
LLM_MODEL_NAME=deepseek-ai/DeepSeek-V3.2
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# Embedding 模型配置
EMBEDDING_API_ENDPOINT=https://api.siliconflow.cn/v1/embeddings
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DIMENSION=1024

# Chroma 向量数据库配置
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=geology_literature

# RAG 配置
RAG_TOP_K=5
RAG_CHUNK_SIZE=1024
RAG_CHUNK_OVERLAP=128
RAG_SIMILARITY_THRESHOLD=0.5

# Agent 配置
AGENT_MAX_ITERATIONS=10
AGENT_TIMEOUT=300
AGENT_VERBOSE=true

# 服务配置
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_DEBUG=false

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
