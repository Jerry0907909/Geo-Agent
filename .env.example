# API 密钥配置（复制为 .env 后填入真实值）
API_KEY=your_api_key_here

# LLM 模型配置
LLM_API_ENDPOINT=https://api.siliconflow.cn/v1/chat/completions
LLM_MODEL_NAME=Qwen/Qwen3.5-397B-A17B
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# Embedding 模型配置
EMBEDDING_API_ENDPOINT=https://api.siliconflow.cn/v1/embeddings
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DIMENSION=1024

# Chroma 向量数据库配置
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=qa_dataset

# RAG 配置
RAG_TOP_K=5
RAG_CHUNK_SIZE=1024
RAG_CHUNK_OVERLAP=128
RAG_SIMILARITY_THRESHOLD=0.5

# Agent 配置
AGENT_MAX_ITERATIONS=10
AGENT_TIMEOUT=300
AGENT_VERBOSE=true

# 服务配置
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_DEBUG=false

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# MySQL数据库配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=geology_agent

# JWT认证配置
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production

# WebSearch 配置（Tavily Search API）
# 注册获取: https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# Redis缓存配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 邮件 SMTP 配置
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_smtp_app_password
EMAIL_FROM=your_email@example.com
